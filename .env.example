# ─────────────────────────────────────────────────────────────────────────────
# MenuPage environment variables. Copy to .env.local for development.
# Everything is optional in DEVELOPMENT: with no DATABASE_URL the app uses an
# embedded Postgres (PGlite) in .data/, magic links are printed to the console,
# and uploads are stored in .data/uploads.
# In PRODUCTION none of those fallbacks exist: database-backed features and sign-in
# require DATABASE_URL, AUTH_SECRET and a real sign-in method. Public pages still load
# if these are missing so a configuration mistake does not take down the whole site.
# `next build` needs no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (no trailing slash). Used for QR codes, links, SEO.
# Vercel Production: https://YOUR-PROJECT.vercel.app or https://your-domain.com
APP_URL=http://localhost:3000
# Optional legacy Auth.js-compatible alias. Prefer APP_URL; keep the two values identical if set.
AUTH_URL=

# ── Database (Neon free tier) ── REQUIRED in production
# Pooled connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL=
# Optional: direct (unpooled) connection string, used for migrations if set
DATABASE_URL_UNPOOLED=

# ── Auth.js ── AUTH_SECRET REQUIRED in production (generate: npx auth secret)
# Existing deployments may keep using NEXTAUTH_SECRET; AUTH_SECRET takes precedence.
AUTH_SECRET=
NEXTAUTH_SECRET=
# ── Sign-in ── PRODUCTION needs at least one: the Google pair and/or Resend + EMAIL_FROM
# Google OAuth. Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic links via Resend. EMAIL_FROM must use a domain verified in Resend.
AUTH_RESEND_KEY=
EMAIL_FROM="MenuPage <login@yourdomain.com>"
# Hidden judge demo at /demo (unlinked; sandbox with a fictional café labelled "Demo data").
# OFF unless exactly "true". Turn on only while judges need it.
DEMO_LOGIN_ENABLED=false

# ── Image uploads: Cloudinary OR Cloudflare R2 ── needed for uploads in production
# Option A: Cloudinary (simplest)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or single URL: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Option B: Cloudflare R2 (free 10 GB)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=menupage
# Public bucket URL: https://pub-xxxx.r2.dev or your custom domain (no trailing slash)
R2_PUBLIC_URL=

# ── Billing: Dodo Payments ── optional; billing is disabled until all are set
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product id of the Pro subscription product (pdt_...)
DODO_PRODUCT_PRO=

# Comma-separated emails that always get Pro without paying (e.g. your own
# freelance clients, or yourself). Optional.
PRO_EMAILS=

# ── Custom domains via Vercel Domains API ── optional
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional: CNAME target shown to owners for subdomains (default cname.vercel-dns.com)
CUSTOM_DOMAIN_TARGET=

# ── Weekly owner digest (Vercel Cron, Mondays 03:30 UTC — see vercel.json) ── optional
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>". Without it the cron
# route answers 503 and nothing is sent. Also needs AUTH_RESEND_KEY + EMAIL_FROM
# (the same Resend key sends reservation alerts and team invites).
CRON_SECRET=

# ── Optional AI helpers on open Gemma models: auto-translate menus (with dish glossary),
#    import a menu from a photo ── Pro only. Everything works without them.
# Provider switch: google (Gemma via Google AI Studio) | ollama (local / any OpenAI-compatible server).
# Unset = google if a key is set, else ollama if a local URL is set, else AI off.
AI_PROVIDER=
# Free key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Legacy alias for GOOGLE_AI_API_KEY. Set one, not both.
GEMINI_API_KEY=
# Default gemma-3-27b-it. If Google answers 404 for the id, one retry uses GEMMA_FALLBACK_MODEL
# (default gemma-4-26b-a4b-it; set to "none" to disable).
GEMMA_MODEL=
GEMMA_VISION_MODEL=
GEMMA_FALLBACK_MODEL=
# Legacy model alias. Used only when it starts with "gemma" and GEMMA_MODEL is unset.
GEMINI_MODEL=
# Local, no cloud: `ollama pull gemma3:4b`, then AI_PROVIDER=ollama (URL defaults to http://localhost:11434, model to gemma3:4b)
OLLAMA_BASE_URL=
# ...or any OpenAI-compatible server (LM Studio, llama.cpp, vLLM): http://host:port/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=

# ── Prep planner (Pro): TabPFN forecast + Gemma prep list, served by the Python agent in /agent
# (deploy with render.yaml on Render's free plan). PRIORLABS_API_KEY lives on the agent, not here.
AGENT_URL=
# Same value as AGENT_SECRET on the agent (Render generates one)
AGENT_SECRET=

# ── Translation scorecard (scripts/eval-translate.ts --scorecard) ── optional, dev only
# Closed baseline compared against Gemma, on the same GOOGLE_AI_API_KEY. Default gemini-3.5-flash-lite.
GEMINI_BASELINE_MODEL=

# ── Sentry tracing (optional) ── no-op when SENTRY_DSN is empty.
# Server-side only: spans around the server actions that call the prep agent; the agent (Render)
# takes its own SENTRY_DSN (can be the same project) and the two join into one trace.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=
